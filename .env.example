ENVIRONMENT=dev
APP_NAME=Fox Passport (Dev)
BASE_URL=http://localhost:6002/api/v1
ENABLE_LOGGING=true
USE_MOCK=true

# --- Social sign-in (optional) ---------------------------------------------
# Browser-redirect flow works with just this; it must be listed in the API's
# MOBILE_REDIRECT_ORIGINS and match the scheme in AndroidManifest.xml.
SOCIAL_REDIRECT_ORIGIN=foxpassport://app

# Native Google sign-in. Use the OAuth *web* client ID (the API's
# GOOGLE_CLIENT_ID) so the ID token is addressed to the backend. Leave empty to
# use the browser flow instead.
GOOGLE_SERVER_CLIENT_ID=
# iOS OAuth client ID (iOS only).
GOOGLE_CLIENT_ID=

# Set true only once the Facebook app ID / client token are configured in
# AndroidManifest.xml and Info.plist. Otherwise Facebook uses the browser flow.
FACEBOOK_NATIVE=false

# Base URL of the FoxPassport web app. Used to hand off flows the mobile app
# does not have yet (role applications, creator dashboard). Optional.
WEB_APP_URL=

# Mapbox PUBLIC access token (pk.…) for the rotating globe. Same kind of token as
# the web app's NEXT_PUBLIC_MAPBOX_TOKEN. Never use a secret sk.… token here.
MAPBOX_ACCESS_TOKEN=
